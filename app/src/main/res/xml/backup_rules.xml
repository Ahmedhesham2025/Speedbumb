<?xml version="1.0" encoding="utf-8"?>
<!-- Android 10-11 backup (android:fullBackupContent). The bump database and settings are backed up;
     crash reports and drive recordings stay on the phone (they hold device details and GPS tracks), and so does the
     shared-map sign-in (sync_auth): a restored phone signs in as a new anonymous device. The "Was this a drive?" holds
     (trip_hold, trip_hold_done) stay too: held data that arrives without its hold is never sent and expires. -->
<full-backup-content>
    <exclude domain="file" path="crash/" />
    <exclude domain="file" path="traces/" />
    <exclude domain="external" path="traces/" />
    <exclude domain="sharedpref" path="sync_auth.xml" />
    <exclude domain="sharedpref" path="trip_hold.xml" />
    <exclude domain="sharedpref" path="trip_hold_done.xml" />
</full-backup-content>
